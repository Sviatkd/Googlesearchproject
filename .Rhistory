# 1. Reshape the data to "Long" format
plotdata_long <- plotdata %>%
# We pivot the actual support and the fitted values
pivot_longer(
cols = c(RefUKip, `Reform UK`, `Labour Party`, fitted1, fitted2, fitted3),
names_to = "metric",
values_to = "value"
) %>%
# Create a grouping variable to separate the Parties from their Fitted lines
mutate(
Party = case_when(
metric %in% c("RefUKip", "fitted1") ~ "UKIP / Radical Right",
metric %in% c("Reform UK", "fitted2") ~ "Reform UK",
metric %in% c("Labour Party", "fitted3") ~ "Labour Party"
),
Type = ifelse(grepl("fitted", metric), "Fitted", "Actual")
)
# 2. Create the Facet Wrap Plot
ggplot(plotdata_long, aes(x = Time, y = value, color = Party)) +
# Points for actual data
geom_point(data = filter(plotdata_long, Type == "Actual"), alpha = 0.4) +
# Lines for fitted models
geom_line(data = filter(plotdata_long, Type == "Fitted"), linewidth = 1.1) +
# Facet by Party
facet_wrap(~Party, scales = "free_y") +
# Custom Colors
scale_color_manual(values = c(
"UKIP / Radical Right" = "purple",
"Reform UK" = "blue",
"Labour Party" = "red"
)) +
theme_classic() +
theme(legend.position = "none") + # Legend is redundant with facets
labs(y = "Support / Search Interest", x = "Date")
