# Define Formula for Inflation Interactions
form_inflation <- "(break2012 + break2015 + break2017 + break2019 + break2020 + break2022)"
# 1. Main Models: The Incumbent vs. The Challenger
model_con_inf <- lm(as.formula(paste("`Conservative Party` ~ Time + Inflation *", form_inflation)), data = data_final)
model_lab_inf <- lm(as.formula(paste("`Labour Party` ~ Time + Inflation *", form_inflation)), data = data_final)
# 2. Falsification: Does Inflation drive the Radical Right?
model_ref_inf <- lm(as.formula(paste("`Reform UK` ~ Time + Inflation *", form_inflation)), data = data_final)
model_rad_inf <- lm(as.formula(paste("RefUKip ~ Time + Inflation *", form_inflation)), data = data_final)
# 3. Robust Standard Errors (HAC)
se_con_inf <- sqrt(diag(vcovHAC(model_con_inf)))
se_lab_inf <- sqrt(diag(vcovHAC(model_lab_inf)))
se_ref_inf <- sqrt(diag(vcovHAC(model_ref_inf)))
se_rad_inf <- sqrt(diag(vcovHAC(model_rad_inf)))
# 4. Output the Inflation Table
stargazer(model_con_inf, model_lab_inf, model_ref_inf, model_rad_inf,
type = "text",
column.labels = c("Conservative", "Labour", "Reform", "RR (Sum)"),
se = list(se_con_inf, se_lab_inf, se_ref_inf, se_rad_inf),
star.cutoffs = c(0.05, 0.01, 0.001),
title = "Economic Voting: The Impact of Inflation",
notes = "Newey-West (HAC) Robust Standard Errors.")
plotdata <- data_clean %>%
mutate(
fitted1 = predict(model_con_inf),
fitted2 = predict(model_lab_inf),
fitted3 = predict(model_ref_inf),
fitted4 = predict(model_rad_inf)
)
library(tidyverse)
# 1. Reshape for the Inflation-focused Facet Plot
plot_inflation_long <- plotdata %>%
pivot_longer(
cols = c(`Conservative Party`, `Labour Party`, `Reform UK`, RefUKip,
fitted1, fitted2, fitted3, fitted4),
names_to = "metric",
values_to = "value"
) %>%
mutate(
Party = case_when(
metric %in% c("Conservative Party", "fitted1") ~ "Conservative - Economic Discourse",
metric %in% c("Labour Party", "fitted2")      ~ "Labour - Economic Discourse",
metric %in% c("Reform UK", "fitted3")        ~ "Reform - Control (Identity)",
metric %in% c("RefUKip", "fitted4")          ~ "RR (Sum) - Control (Identity)"
),
Type = ifelse(grepl("fitted", metric), "Fitted", "Actual")
)
# 2. Set factor levels for logical vertical order
plot_inflation_long$Party <- factor(plot_inflation_long$Party, levels = c(
"Conservative - Economic Discourse",
"Labour - Economic Discourse",
"Reform - Control (Identity)",
"RR (Sum) - Control (Identity)"
))
# 3. Generate the Plot
ggplot(plot_inflation_long, aes(x = Time, y = value, color = Party)) +
# Actual Data Points (Faded)
geom_point(data = filter(plot_inflation_long, Type == "Actual"), alpha = 0.5) +
# Fitted Regression Lines
geom_line(data = filter(plot_inflation_long, Type == "Fitted"), linewidth = 1.1) +
# Vertical Faceting with free y-axes
facet_wrap(~Party, scales = "free_y", ncol = 1) +
# Consistent color mapping
scale_color_manual(values = c(
"Conservative - Economic Discourse" = "darkblue",
"Labour - Economic Discourse"       = "red",
"Reform - Control (Identity)"       = "blue",
"RR (Sum) - Control (Identity)"     = "purple"
)) +
theme_classic() +
theme(
strip.background = element_rect(fill = "gray95", color = "gray80"),
strip.text = element_text(face = "bold", size = 10),
legend.position = "none"
) +
labs(
title = "Discriminant Validity: Inflation as an Economic Predictor",
subtitle = "Mainstream Parties (Economic Discourse) vs. Radical Right (Identity Control)",
y = "Support / Search Interest",
x = "Date"
)
stargazer(ols_interaction1,ols_interaction2,ols_interaction3,ols_interaction4,
se = list(sqrt(diag(vcovHAC(ols_interaction1))),sqrt(diag(vcovHAC(ols_interaction2))),sqrt(diag(vcovHAC(ols_interaction3))),sqrt(diag(vcovHAC(ols_interaction4)))),
type = "text")
